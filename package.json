{
  "name": "adb-onetwo",
  "productName": "OneTwo ADB Studio",
  "version": "0.27.3",
  "private": true,
  "description": "OneTwo ADB Studio: builds and tests the workflows that OneTwo ADB pays with",
  "main": "app/boot.js",
  "scripts": {
    "start": "electron .",
    "start:user": "set ONETWO_EDITION=user&& electron .",
    "test": "node --test",
    "icons": "electron tools/make-icons.js",
    "release": "node tools/release.js",
    "build:user": "node tools/build-app.js user",
    "release:user": "node tools/release-user.js",
    "build:studio": "node tools/build-app.js studio"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "updateUrl": "https://raw.githubusercontent.com/Florentino-coder/onetwo-letsgo/main/updates/",
  "userUpdateUrl": "https://raw.githubusercontent.com/Florentino-coder/onetwo-adb-updates/main/updates/"
}
